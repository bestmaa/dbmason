PORT=3010
# Exact browser-facing origin. Non-loopback deployments must use HTTPS.
DBMASON_PUBLIC_URL=http://localhost:3010
NEXT_TELEMETRY_DISABLED=1
# Bind to loopback by default; use 0.0.0.0 only for deliberate direct network exposure.
DBMASON_BIND_ADDRESS=127.0.0.1
# Keep dbmason:local to build from this checkout, or use a tagged/digest GHCR image.
DBMASON_IMAGE=dbmason:local
# Optional Docker Compose runtime ceilings. Increase deliberately for larger installations.
DBMASON_CPU_LIMIT=1.0
DBMASON_MEMORY_LIMIT=384m
DATABASE_URL=file:./data/control-plane.db
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
# Master key for connection credentials and a separately derived 2FA encryption subkey.
CONNECTION_ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional comma-separated exact hosts or wildcard domains such as *.db.example.com.
DATABASE_HOST_ALLOWLIST=
# Public corresponding-source URL for this exact build. Forks should point this at their source.
# Defaults to the official GitHub tag matching package.json when omitted.
DBMASON_SOURCE_URL=
