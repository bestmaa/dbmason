PORT=3010
DATABASE_URL=file:./data/control-plane.db
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
CONNECTION_ENCRYPTION_KEY=replace-with-64-hex-characters
# Optional comma-separated exact hosts or wildcard domains such as *.db.example.com.
DATABASE_HOST_ALLOWLIST=
# Public corresponding-source URL for this exact build. Forks should point this at their source.
# Defaults to the official GitHub tag matching package.json when omitted.
DBMASON_SOURCE_URL=
